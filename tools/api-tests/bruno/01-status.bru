meta {
  name: Status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/status
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("body reports ok", function() {
    expect(res.body.status).to.equal("ok");
  });
}

docs {
  ## Status

  Liveness check for the GM API inside `worldserver`.

  - Method and path: `GET /api/v1/status`.
  - Path and query parameters: none.
  - Body: none.
  - Signature headers: `X-GM-Timestamp`, `X-GM-Nonce`, `X-GM-Signature`. The `collection.bru`
    pre-request script sets all of them. No `X-GM-Actor`, no RBAC permission.
  - Success: `200` with `{"status":"ok"}`.
  - Failure: `401 unauthorized` (bad signature or timestamp), `405 method_not_allowed`,
    `409 replayed_nonce`, `429 rate_limited`.

  Use this first to confirm the API is listening on `{{baseUrl}}` before sending any write.
}
