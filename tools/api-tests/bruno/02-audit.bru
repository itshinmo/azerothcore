meta {
  name: Audit
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/audit?limit={{auditLimit}}
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("body is a list", function() {
    expect(res.body).to.be.an("array");
  });
}

docs {
  ## Audit

  Recent rows from `acore_auth.gm_audit_log`, newest first.

  - Method and path: `GET /api/v1/audit?limit={{auditLimit}}`.
  - Path parameters: none.
  - Query parameters: `limit` (optional). 0, invalid, or missing values use the server default of
    `50`; values above `200` clamp to `200`.
  - Body: none.
  - Signature headers: `X-GM-Timestamp`, `X-GM-Nonce`, `X-GM-Signature`, set by `collection.bru`.
    No `X-GM-Actor`, no RBAC permission.
  - Success: `200` with an array of audit rows. Each row has `id`, `realm_id`, `account_name`,
    `player_name`, `command`, optional `arguments`, optional `result`, and `created_at`.
  - Failure: `401 unauthorized`, `405 method_not_allowed`, `409 replayed_nonce`,
    `429 rate_limited`.

  After a write, check here for the `pending` row and the terminal row: `success`, `denied`,
  `target_not_found`, `cannot_target_self`, `player_busy`, `teleport_failed`, `inventory_full`,
  `mailbox_full`, `longer_ban_exists`, RBAC conflicts, `world_timeout`, or `world_unavailable`.
}
