meta {
  name: Debug URL
  type: http
  seq: 99
}

get {
  url: {{baseUrl}}/api/v1/characters/{{playerName}}
  body: none
  auth: none
}

script:pre-request {
  console.log('URL:', req.getUrl());
  console.log('PATH:', req.getPath());
  console.log('QUERY:', req.getQueryString());
  console.log('INTERP PATH:', bru.interpolate(req.getPath()));
}
