# Optional local overrides for tools/dev scripts.
# Copy to tools/dev/config.env (ignored) and edit. Never commit real credentials.

# Test realm (tools/dev/test-realm.sh)
# TEST_DB_PASSWORD=change-me          # letters, digits, dot, underscore, hyphen only
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=acore_test
# TEST_AUTH_PORT=3824
# TEST_WORLD_PORT=8185
# MYSQL_ADMIN_USER=acore_admin        # dedicated admin, not root
# MYSQL_ADMIN_PASSWORD=

# Backups (tools/dev/backup.sh)
# BACKUP_RETENTION_DAYS=14
