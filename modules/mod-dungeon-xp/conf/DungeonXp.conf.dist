#
# Dungeon XP
# Rebalance split (ADR-012 revision 2026-11-20): dungeon mob/boss XP reduced, dungeon
# quest XP raised — dungeons become one-time story events, not repeatable XP farms, and
# world questing stays the fastest path to 80.
#

# Multiplier for kill XP earned inside dungeon (and raid, see below) maps. Applies to the
# core kill XP for every mob and boss in the instance. BG kills unaffected.
DungeonXp.KillFactor = 0.33

# Multiplier for dungeon quest XP, on top of the global Rate.XP.Quest (2x here): with the
# default, a dungeon quest pays 4x one-time. Detection is data-driven (the quest's zone
# points at the dungeon's area); quests with no dungeon zone keep the world rate.
DungeonXp.QuestFactor = 2.0

# Apply the kill reduction to raid maps too (MapEntry::IsDungeon covers both).
DungeonXp.IncludeRaids = 1
