#
# PvP Rulesets
# One realm, three per-character modes (RFC-006, ADR-033).
#

# Enable the module. Shipping default is 0 (RFC-006 proposal until ADR-033 is accepted).
# The local test realm enables it in env/dist/etc/modules/PvpRulesets.conf, which is not
# tracked. Disabling the module ignores stored modes and leaves the tables in place.
PvpRulesets.Enable = 0

# Outdoor experience bonus in percent. War Mode ships at +10%, High Risk at +15%.
# The bonus is outdoor-only and is not applied in instances, battlegrounds, arenas,
# battlefields, sanctuaries or no-PvP areas.
PvpRulesets.WarMode.XpBonusPercent = 10
PvpRulesets.HighRisk.XpBonusPercent = 20

# Persisted cooldown for every accepted pledge change, in minutes.
PvpRulesets.ToggleCooldownMinutes = 5

# Pledge location is NOT configurable. `.pledge` works only in these ten capital cities,
# matching the player's faction:
#   Alliance: 1519 Stormwind City, 1537 Ironforge, 1657 Darnassus, 3557 The Exodar
#   Horde:    1637 Orgrimmar, 1497 Undercity, 1638 Thunder Bluff, 3487 Silvermoon City
#   Both:     3703 Shattrath City, 4395 Dalaran
# The stock AREA_FLAG_CAPITAL flag covers 35 AreaTable rows (Stormwind Harbor, Acherus:
# The Ebon Hold, every Dalaran sub-area, The Forlorn Cavern, ...), so it is not used. The
# list is a game-design decision, not a tuning knob: it lives in
# src/PvpRulesets.h (`PLEDGE_AREAS`), is checked against the player's faction, and the
# unit tests pin it. There is deliberately no config option for it.
